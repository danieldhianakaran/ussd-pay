<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:paddingBottom="8dp"
            android:text="Idle" />

        <!-- Big square QR button, with the autofill toggle beside it -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top">

            <ImageButton
                android:id="@+id/btnScan"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@drawable/qr_button_bg"
                android:padding="36dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_qr"
                android:contentDescription="Scan UPI QR" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingLeft="12dp">

                <Switch
                    android:id="@+id/swAutofill"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Autofill"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvAutofillState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:text="Autofill: off" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:text="Tap the QR to scan. Autofill types the UPI ID and amount for you; you always enter the PIN."
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="UPI ID (VPA)"
            android:textSize="12sp"
            android:paddingTop="10dp" />

        <EditText
            android:id="@+id/etVpa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textNoSuggestions"
            android:hint="name@bank" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Amount (INR)"
            android:textSize="12sp"
            android:paddingTop="10dp" />

        <EditText
            android:id="@+id/etAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:hint="0.00" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Note"
            android:textSize="12sp"
            android:paddingTop="10dp" />

        <EditText
            android:id="@+id/etNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textNoSuggestions"
            android:maxLength="40" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/start_ussd" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="USSD session"
            android:textSize="12sp"
            android:paddingTop="14dp" />

        <com.daniel.ussdpay.InnerScrollView
            android:id="@+id/logScroll"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="#11000000"
            android:scrollbarStyle="insideOverlay"
            android:fadeScrollbars="false">

            <TextView
                android:id="@+id/tvTranscript"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:textSize="12sp"
                android:typeface="monospace"
                android:text="No session yet." />
        </com.daniel.ussdpay.InnerScrollView>

        <Button
            android:id="@+id/btnHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Transaction history (30 days)" />

        <Button
            android:id="@+id/btnClear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Clear log" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:textSize="11sp"
            android:text="USSD menus are controlled by your bank and telecom operator. This app only sends what you confirm." />
    </LinearLayout>
</ScrollView>
